DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_crm"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Optional for local dev. Leave empty to infer http://localhost:$PORT automatically.
NEXTAUTH_URL=""
REDIS_URL=""
WS_URL=""
SEED_DEMO_DATA=""
ENCRYPTION_KEY=""
FHIR_BASE_URL=""
FHIR_AUTH_TOKEN=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# S3 / Object Storage (optional - falls back to local ./uploads/ if not set)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: for S3-compatible providers (R2, MinIO, Backblaze B2, DigitalOcean Spaces)
S3_ENDPOINT=""

# Clearinghouse Provider (optional - "mock" or "availity", defaults to "mock")
CLEARINGHOUSE_PROVIDER="mock"
# Availity API (only needed if CLEARINGHOUSE_PROVIDER=availity)
AVAILITY_CLIENT_ID=""
AVAILITY_CLIENT_SECRET=""
AVAILITY_BASE_URL=""
